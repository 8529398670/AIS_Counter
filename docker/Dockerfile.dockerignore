# What the build context leaves out. The context is the project root
# (docker/lib.sh runs `docker build -f docker/Dockerfile .`), and BuildKit
# reads this file because it sits beside that Dockerfile and is named after it.
.git
.gitignore
.run/
data/
*.db
*.db-wal
*.db-shm
# Holds the secret key: never in an image layer, which is forever.
config/config.yaml
*.md
# ...except the report the About screen shows (app/routes/meta.py).
!docs/ais_auto_report.md
docker/
scripts/
misc/
app/core/layout_pinned.py
app/build_info.py
**/__pycache__
**/*.pyc
.venv/
venv/
# This repo's research material: MATLAB original and multi-GB sample images.
example-data/
original-code/
# ...except the original itself: MATLAB replays are built from it (app/analysis/matlab.py).
!original-code/ais_auto.m
# Built inside the image, for the image.
helper/dist/
notes.txt
gitPushUpdate.sh
