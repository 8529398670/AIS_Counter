# Data (large, local only)
/example-data
/example-data-2
/example-data-3
.DS_Store
.claude/
.pytest_cache/

# Runtime state -- never commit these. config/secret.key is the key that reads
# the database; config/config.yaml is this deployment's settings (and, until the
# server first starts on the new code, the old copy of the key).
# config/config.example.yaml is the committed copy. The bare names also catch a
# stray copy anywhere else.
config.yaml
secret.key
# A key rotation's new key, and every key it has retired.
secret.key.*
config.yaml.bak
.config.yaml.*.tmp
*.db-journal

# Local runtime
.venv/
venv/
.run/
data/
*.db
*.db-wal
*.db-shm

# Generated at build time
app/core/layout_pinned.py
app/build_info.py

# Python
__pycache__/
*.pyc

# MATLAB parity harness output (generated from local example-data)
tests/matlab/build/
tests/golden/

# scripts/export_batches.py default output
exports/

gitPushUpdate.sh
# The MATLAB helper, built by helper/build.sh.
helper/dist/
